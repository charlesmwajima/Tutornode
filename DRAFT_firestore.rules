rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helper Functions ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Validation Blueprints ---

    function isValidLesson(data) {
      return data.keys().hasAll(['topic', 'whiteboard_notes', 'teacher_dialogue', 'timestamp', 'userId'])
        && data.keys().size() == 5
        && data.topic is string && data.topic.size() <= 500
        && data.whiteboard_notes is string && data.whiteboard_notes.size() <= 50000
        && data.teacher_dialogue is string && data.teacher_dialogue.size() <= 50000
        && data.timestamp == request.time
        && data.userId == request.auth.uid;
    }

    function isValidFeedback(data) {
      return data.keys().hasAll(['topic', 'teacher_dialogue', 'quality_score', 'relevance_score', 'comments', 'timestamp', 'userId'])
        && data.keys().size() == 7
        && data.topic is string && data.topic.size() <= 500
        && data.quality_score is number && data.quality_score >= 1 && data.quality_score <= 5
        && data.relevance_score is number && data.relevance_score >= 1 && data.relevance_score <= 5
        && data.comments is string && data.comments.size() <= 2000
        && data.timestamp == request.time
        && data.userId == request.auth.uid;
    }

    // --- Collection Routes ---

    match /lessons/{lessonId} {
      allow get: if isOwner(existing().userId);
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidLesson(incoming());
      // Lessons are immutable for now
      allow update, delete: if false;
    }

    match /feedbacks/{feedbackId} {
      // Feedbacks are usually for admins, but let's allow owner to read their own or admins
      allow get: if isOwner(existing().userId);
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidFeedback(incoming());
      allow update, delete: if false; 
    }
  }
}
