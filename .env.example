# GEMINI_API_KEY: Server-side Gemini API key (required for AI tutor, lessons, quizzes, syllabi, and document analysis)
# Configure this in Vercel Project Settings > Environment Variables (or AI Studio Settings > Secrets)
GEMINI_API_KEY=

# BLOB_READ_WRITE_TOKEN: Optional Vercel Blob token for persistent uploaded documents and exported lesson assets
BLOB_READ_WRITE_TOKEN=

# APP_URL: Canonical deployment URL (e.g., https://tutornode.vercel.app)
APP_URL=
