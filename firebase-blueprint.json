{
  "entities": {
    "Feedback": {
      "title": "Feedback",
      "description": "Student lesson quality evaluation and improvement feedback",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "topic": { "type": "string", "maxLength": 300 },
        "teacher_dialogue": { "type": "string", "maxLength": 20000 },
        "quality_score": { "type": "integer" },
        "relevance_score": { "type": "integer" },
        "comments": { "type": "string", "maxLength": 2000 },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "topic", "quality_score", "relevance_score", "timestamp"]
    },
    "Lesson": {
      "title": "Lesson",
      "description": "Saved TutorNode lesson session with structured notes, segments, and diagrams",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "topic": { "type": "string", "maxLength": 300 },
        "subject": { "type": "string", "maxLength": 160 },
        "educationLevel": { "type": "string", "maxLength": 80 },
        "whiteboard_notes": { "type": "string", "maxLength": 200000 },
        "teacher_dialogue": { "type": "string", "maxLength": 150000 },
        "segments": { "type": "array" },
        "structured_lesson": { "type": "object" },
        "visual_diagram_prompt": { "type": "string", "maxLength": 2000 },
        "diagram_svg_code": { "type": "string", "maxLength": 200000 },
        "video_scene": { "type": "string", "maxLength": 2000 },
        "video_keyword": { "type": "string", "maxLength": 120 },
        "is_exam_revision": { "type": "boolean" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "topic", "whiteboard_notes", "teacher_dialogue", "timestamp"]
    },
    "Syllabus": {
      "title": "Syllabus",
      "description": "User coursework syllabus and topic progression",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "title": { "type": "string", "maxLength": 200 },
        "description": { "type": "string", "maxLength": 1500 },
        "chapters": { "type": "array" },
        "modules": { "type": "array" },
        "isPublic": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "title", "description", "chapters", "createdAt"]
    },
    "ExamPaper": {
      "title": "ExamPaper",
      "description": "Uploaded or shared examination paper metadata or compact file payload",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "maxLength": 255 },
        "mimeType": { "type": "string", "maxLength": 100 },
        "data": { "type": "string", "maxLength": 850000 },
        "blobUrl": { "type": "string", "maxLength": 1000 },
        "isShared": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "name", "mimeType", "createdAt"]
    },
    "QuizAttempt": {
      "title": "QuizAttempt",
      "description": "Completed interactive quiz attempt with score and answer review",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "topic": { "type": "string", "maxLength": 300 },
        "studyLevel": { "type": "string", "maxLength": 80 },
        "score": { "type": "number" },
        "total": { "type": "integer" },
        "percentage": { "type": "number" },
        "answers": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "topic", "score", "total", "percentage", "answers", "createdAt"]
    },
    "DocumentRecord": {
      "title": "DocumentRecord",
      "description": "Analyzed study document metadata and AI analysis output",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "fileName": { "type": "string", "maxLength": 255 },
        "mimeType": { "type": "string", "maxLength": 100 },
        "sizeBytes": { "type": "integer" },
        "blobUrl": { "type": "string", "maxLength": 1000 },
        "action": { "type": "string", "maxLength": 60 },
        "analysis": { "type": "object" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "fileName", "mimeType", "action", "analysis", "createdAt"]
    },
    "TutorThread": {
      "title": "TutorThread",
      "description": "Persistent Q&A dialogue thread between student and AI tutor",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "topic": { "type": "string", "maxLength": 300 },
        "messages": { "type": "array" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "topic", "messages", "updatedAt"]
    },
    "VideoJob": {
      "title": "VideoJob",
      "description": "Persistent serverless storyboard or video export tracking record",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "topic": { "type": "string", "maxLength": 300 },
        "mode": { "type": "string", "enum": ["storyboard", "webm", "veo"] },
        "status": { "type": "string", "enum": ["queued", "processing", "completed", "failed"] },
        "blobUrl": { "type": "string", "maxLength": 1000 },
        "storyboard": { "type": "object" },
        "error": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "topic", "mode", "status", "createdAt", "updatedAt"]
    },
    "AppSettings": {
      "title": "AppSettings",
      "description": "Global TutorNode feature availability configuration",
      "type": "object",
      "properties": {
        "comingSoon": { "type": "boolean" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["comingSoon", "updatedAt"]
    }
  },
  "firestore": {
    "/feedbacks/{feedbackId}": {
      "schema": { "$ref": "#/entities/Feedback" },
      "description": "Student lesson feedback records"
    },
    "/lessons/{lessonId}": {
      "schema": { "$ref": "#/entities/Lesson" },
      "description": "User saved lessons and exam revision archives"
    },
    "/syllabi/{syllabusId}": {
      "schema": { "$ref": "#/entities/Syllabus" },
      "description": "User coursework syllabi"
    },
    "/exams/{examId}": {
      "schema": { "$ref": "#/entities/ExamPaper" },
      "description": "User uploaded or explicitly shared exam papers"
    },
    "/quizAttempts/{attemptId}": {
      "schema": { "$ref": "#/entities/QuizAttempt" },
      "description": "User quiz attempt scores and answer reviews"
    },
    "/documents/{docId}": {
      "schema": { "$ref": "#/entities/DocumentRecord" },
      "description": "Analyzed study documents and extracted notes"
    },
    "/tutorThreads/{threadId}": {
      "schema": { "$ref": "#/entities/TutorThread" },
      "description": "Persistent Q&A tutor conversations per user"
    },
    "/videoJobs/{jobId}": {
      "schema": { "$ref": "#/entities/VideoJob" },
      "description": "Persistent storyboard/video export tracking records"
    },
    "/appSettings/{settingId}": {
      "schema": { "$ref": "#/entities/AppSettings" },
      "description": "Global platform configuration flags"
    }
  }
}
